---
type Props = {
  title?: string;
  description?: string;
  ogUrl?: string;
};

const {
  title = "RDR & Associates | Strategic Financial Stewardship & Accounting Firm",
  description = "Unwavering financial clarity for individuals and businesses. RDR & Associates provides institutional-grade accounting, tax compliance, and strategic advisory services.",
} = Astro.props;

const computedOgUrl = (() => {
  if (Astro.props.ogUrl) return Astro.props.ogUrl;
  const base = Astro.site ?? new URL("https://rdrca.com");
  return new URL(Astro.url.pathname, base).toString();
})();

import "../styles/global.css";
---

