---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBlogPostBySlug, getBlogSlugs } from '../../lib/fetch';

export async function getStaticPaths() {
  const slugs = await getBlogSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = slug ? await getBlogPostBySlug(slug) : null;

if (!post) {
  return Astro.redirect('/blog');
}

const pageTitle = post.seo?.title ?? `${post.title} | RDR & Associates`;
const pageDescription = post.seo?.description ?? post.excerpt;
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <section class="relative pt-32 pb-10 lg:pt-40 lg:pb-16 overflow-hidden">
    <div class="absolute inset-0 -z-20 h-full w-full bg-white"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-50/50 via-white to-white"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#676769_1px,transparent_1px),linear-gradient(to_bottom,#676769_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-[0.03]"></div>

    <div class="max-w-4xl mx-auto px-8 relative z-10 text-center">
      <div class="flex items-center justify-center gap-3 text-sm font-semibold uppercase tracking-widest text-[#3305d8] mb-6">
        <span>{post.category}</span>
        {post.subcategory && (
          <>
            <span class="text-[#676769]/30">&bull;</span>
            <span>{post.subcategory}</span>
          </>
        )}
        <span class="text-[#676769]/30">&bull;</span>
        <span>{post.formattedDate}</span>
      </div>

      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight text-slate-900 leading-[1.1] mb-8">
        {post.title}
      </h1>

      <div class="flex items-center justify-center gap-4 text-slate-500 font-medium text-sm">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-slate-200 overflow-hidden">
            <svg class="w-full h-full text-slate-400 p-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          </div>
          <span>{post.author ?? 'RDR Team'}</span>
        </div>
        {post.readTime && (
          <>
            <span class="text-slate-300">|</span>
            <span>{post.readTime} min read</span>
          </>
        )}
      </div>
    </div>
  </section>

  {post.coverImageUrl && (
    <section class="max-w-5xl mx-auto px-6 mb-20 pt-10">
      <div class="aspect-w-16 aspect-h-9 rounded-2xl overflow-hidden shadow-2xl shadow-[#3305d8]/10">
        <img
          src={post.coverImageUrl}
          alt={post.mainImage?.alt ?? post.title}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </section>
  )}

  <article class="max-w-3xl mx-auto px-6 pb-32">
    <div
      class="prose prose-lg prose-slate prose-headings:font-serif prose-headings:font-medium prose-a:text-[#3305d8] prose-a:no-underline hover:prose-a:underline focus:prose-a:underline prose-img:rounded-xl"
      set:html={post.htmlBody}
    />

    <div class="border-t border-[#676769]/10 mt-16 pt-8 flex flex-col md:flex-row items-center justify-between gap-6">
      {post.tags && post.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          <span class="text-xs font-semibold uppercase tracking-widest text-[#676769] py-1">Tags:</span>
          {post.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium uppercase tracking-wider text-[#3305d8] bg-[#3305d8]/5 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="flex items-center gap-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#676769]">Share:</span>
        <a href="#" class="text-slate-400 hover:text-[#3305d8] transition-colors" aria-label="Share on LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="#" class="text-slate-400 hover:text-[#3305d8] transition-colors" aria-label="Share on X">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
        </a>
      </div>
    </div>
  </article>
</SiteLayout>
