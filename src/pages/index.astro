---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout>
  <section class="overflow-hidden lg:pt-52 lg:pb-36 border-[#3305d8]/10 border-b pt-40 pb-28 relative">
    <div class="absolute inset-0 -z-20 h-full w-full bg-white"></div>
    <div class="absolute inset-0 -z-10 h-full w-full">
      <img
        src="https://images.unsplash.com/photo-1710776531873-fa1c10b7a68f?w=1920&q=80"
        alt="Financial Architecture"
        class="h-full w-full object-cover opacity-[0.05] saturate-0 mix-blend-multiply"
      />
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-50/50 via-white to-white"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#676769_1px,transparent_1px),linear-gradient(to_bottom,#676769_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-[0.03]"></div>

    <div class="absolute right-0 bottom-20 translate-x-1/3 opacity-30 pointer-events-none -z-10 w-[1200px] animate-float">
      <svg viewBox="0 0 1440 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M-100 200 C 400 250 800 50 1540 150" stroke="url(#sw-gradient)" stroke-width="3" fill="none"></path>
      </svg>
    </div>

    <div class="max-w-7xl mr-auto ml-auto pr-8 pl-8">
      <div class="flex flex-col text-center items-center">
        <div class="relative z-10 max-w-5xl mx-auto">
          <h1 class="hero-headline font-serif text-6xl font-medium tracking-tight text-slate-900 md:text-8xl leading-[1.05]">
            <p>Unwavering <em>financial</em> clarity.</p>
          </h1>
          <p class="leading-relaxed text-2xl font-light text-[#676769] max-w-2xl mt-10 mr-auto ml-auto">
            We provide institutional-grade accounting and strategic advisory for those who demand precision. R D R &amp; Associates creates the foundation for your legacy.
          </p>
          <div class="mt-14 flex flex-wrap justify-center gap-6">
            <a href="/services" class="btn-curtain uppercase text-sm font-medium text-white tracking-widest pt-5 pr-10 pb-5 pl-10 bg-[#3305d8] border border-[#3305d8] hover:bg-[#20038a] hover:border-[#20038a] transition-all duration-300 shadow-indigo-900/10">
              Explore Services
            </a>
            <a href="/contact" class="group flex items-center gap-3 px-10 py-5 text-sm font-medium uppercase tracking-widest text-slate-900 transition-all hover:gap-5 hover:text-[#3305d8]">
              Contact RDR
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-right" class="lucide lucide-arrow-right h-5 w-5">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-32 relative overflow-hidden">
    <div class="absolute left-0 top-10 -translate-x-1/4 opacity-20 pointer-events-none z-0 w-[1000px]">
      <svg viewBox="0 0 1440 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto transform -scale-x-100">
        <path d="M-100 150 C 400 100 800 250 1540 100" stroke="url(#sw-gradient)" stroke-width="3" fill="none"></path>
      </svg>
    </div>

    <div class="mx-auto max-w-7xl px-8 relative z-10">
      <div class="grid gap-20 lg:grid-cols-2 lg:items-center">
        <div class="flex flex-col items-center justify-center text-center">
          <div class="relative inline-block">
            <h2 class="text-[200px] leading-[0.8] -translate-y-16 font-medium text-[#3305d8] tracking-tighter font-serif z-10 relative">
              30<span class="absolute -right-12 top-2 font-serif text-7xl font-normal text-[#3305d8]/60">+</span>
            </h2>
            <div class="relative z-20 -mt-8 font-serif text-6xl text-[#3305d8]">YEARS</div>
          </div>
          <p class="uppercase -translate-y-8 text-sm font-semibold text-slate-900/60 tracking-[0.4em] mt-10">of Experience</p>
        </div>
        <div class="lg:pl-12">
          <span class="mb-6 block text-sm font-semibold uppercase tracking-widest text-[#3305d8]">Who We Are</span>
          <h2 class="leading-tight sm:text-6xl text-5xl font-medium text-slate-900 tracking-tight font-serif mb-8">
            Trust Worthy firm of Chartered Accountants for professional &amp; personal growth.
          </h2>
          <p class="leading-relaxed text-2xl font-light text-[#676769]">
            Our experienced team of Chartered Accountants combined with decades of experience in top international audit and consulting firms ensures you receive the professional accountancy assistance you deserve.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Clientele (Client Profile) -->
  <section class="overflow-hidden bg-gradient-to-b from-white via-slate-50 to-[#3305d8]/5 pt-32 pb-32" id="clientele">
    <div class="max-w-7xl mr-auto ml-auto pr-8 pl-8">
      <div class="md:flex md:items-end md:justify-between mb-20">
        <div class="max-w-2xl">
          <span class="uppercase text-sm font-semibold tracking-widest text-[#3305d8]">Client Profile</span>
          <h2 class="text-5xl font-medium text-slate-900 font-serif mt-4">Who We Serve</h2>
          <p class="text-2xl font-light text-slate-900 mt-6">Tailored financial strategies for every stage of your journey.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="group relative h-[28rem] overflow-hidden bg-white p-10 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#3305d8]/20">
          <div class="transition-all duration-500 group-hover:bg-[#3305d8]/5 bg-gray-100 w-40 h-40 rounded-full absolute top-0 right-0 translate-x-16 translate-y-[-50%]"></div>
          <div class="relative z-10 flex h-full flex-col justify-between">
            <div>
              <div class="mb-8 inline-flex h-14 w-14 items-center justify-center rounded-full border border-[#676769]/20 bg-white shadow-sm transition-colors duration-300 group-hover:border-[#3305d8]/20 group-hover:bg-[#3305d8]/10 group-hover:text-[#3305d8]">
                <i data-lucide="user" class="h-7 w-7"></i>
              </div>
              <h3 class="font-serif text-3xl text-slate-900 group-hover:text-[#3305d8] transition-colors">Individuals</h3>
            </div>
            <div>
              <div class="h-px w-full bg-[#676769]/20 my-8 transition-all duration-500 group-hover:bg-[#3305d8]/20"></div>
              <p class="leading-relaxed group-hover:text-slate-800 text-lg font-light text-[#676769]">
                Income tax planning and return filing for optimized personal compliance.
              </p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 h-1.5 w-0 transition-all duration-500 group-hover:w-full bg-[#3305d8]"></div>
        </div>

        <div class="group relative h-[28rem] overflow-hidden bg-white p-10 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#3305d8]/20">
          <div class="transition-all duration-500 group-hover:bg-[#3305d8]/5 bg-gray-100 w-40 h-40 rounded-full absolute top-0 right-0 translate-x-16 translate-y-[-50%]"></div>
          <div class="relative z-10 flex h-full flex-col justify-between">
            <div>
              <div class="mb-8 inline-flex h-14 w-14 items-center justify-center rounded-full border border-[#676769]/20 bg-white shadow-sm transition-colors duration-300 group-hover:border-[#3305d8]/20 group-hover:bg-[#3305d8]/10 group-hover:text-[#3305d8]">
                <i data-lucide="briefcase" class="h-7 w-7"></i>
              </div>
              <h3 class="font-serif text-3xl text-slate-900 group-hover:text-[#3305d8] transition-colors">Business Owners</h3>
            </div>
            <div>
              <div class="h-px w-full bg-[#676769]/20 my-8 transition-all duration-500 group-hover:bg-[#3305d8]/20"></div>
              <p class="leading-relaxed group-hover:text-slate-800 text-lg font-light text-[#676769]">
                End-to-end bookkeeping, GST/ TDS/PF/ESI &amp; PT compliance, and profit advisory for business growth.
              </p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 h-1.5 w-0 transition-all duration-500 group-hover:w-full bg-[#3305d8]"></div>
        </div>

        <div class="group relative h-[28rem] overflow-hidden bg-white p-10 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#3305d8]/20">
          <div class="transition-all duration-500 group-hover:bg-[#3305d8]/5 bg-gray-100 w-40 h-40 rounded-full absolute top-0 right-0 translate-x-16 translate-y-[-50%]"></div>
          <div class="relative z-10 flex h-full flex-col justify-between">
            <div>
              <div class="mb-8 inline-flex h-14 w-14 items-center justify-center rounded-full border border-[#676769]/20 bg-white shadow-sm transition-colors duration-300 group-hover:border-[#3305d8]/20 group-hover:bg-[#3305d8]/10 group-hover:text-[#3305d8]">
                <i data-lucide="pen-tool" class="h-7 w-7"></i>
              </div>
              <h3 class="font-serif text-3xl text-slate-900 group-hover:text-[#3305d8] transition-colors">Firms</h3>
            </div>
            <div>
              <div class="h-px w-full bg-[#676769]/20 my-8 transition-all duration-500 group-hover:bg-[#3305d8]/20"></div>
              <p class="leading-relaxed group-hover:text-slate-800 text-lg font-light text-[#676769]">
                Comprehensive accounting, tax structuring, and statutory compliance for partners and operations.
              </p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 h-1.5 w-0 transition-all duration-500 group-hover:w-full bg-[#3305d8]"></div>
        </div>

        <div class="group relative h-[28rem] overflow-hidden bg-white p-10 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#3305d8]/20">
          <div class="transition-all duration-500 group-hover:bg-[#3305d8]/5 bg-gray-100 w-40 h-40 rounded-full absolute top-0 right-0 translate-x-16 translate-y-[-50%]"></div>
          <div class="relative z-10 flex h-full flex-col justify-between">
            <div>
              <div class="mb-8 inline-flex h-14 w-14 items-center justify-center rounded-full border border-[#676769]/20 bg-white shadow-sm transition-colors duration-300 group-hover:border-[#3305d8]/20 group-hover:bg-[#3305d8]/10 group-hover:text-[#3305d8]">
                <i data-lucide="building-2" class="h-7 w-7"></i>
              </div>
              <h3 class="font-serif text-3xl text-slate-900 group-hover:text-[#3305d8] transition-colors">Corporates</h3>
            </div>
            <div>
              <div class="h-px w-full bg-[#676769]/20 my-8 transition-all duration-500 group-hover:bg-[#3305d8]/20"></div>
              <p class="leading-relaxed group-hover:text-slate-800 text-lg font-light text-[#676769]">
                Fullspectrum audit, taxation, and strategic advisory for governance and expansion.
              </p>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 h-1.5 w-0 transition-all duration-500 group-hover:w-full bg-[#3305d8]"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Offerings (What We Do) -->
  <section class="overflow-hidden bg-gradient-to-b from-[#3305d8]/5 via-slate-50 to-white pt-40 pb-40 relative" id="services">
    <div class="absolute left-0 top-0 h-full w-px bg-gradient-to-b from-transparent via-[#676769]/20 to-transparent"></div>
    <div class="absolute right-0 top-0 h-full w-px bg-gradient-to-b from-transparent via-[#676769]/20 to-transparent"></div>

    <div class="mx-auto max-w-7xl px-8">
      <div class="grid lg:grid-cols-3 gap-16">
        <div class="lg:col-span-1">
          <div class="sticky top-40">
            <span class="uppercase text-sm font-semibold tracking-widest text-[#3305d8]">What We Do</span>
            <h2 class="leading-[1.05] text-5xl text-slate-900 tracking-tight font-serif mt-6">Our Services</h2>
            <p class="mt-8 text-[#676769] font-light text-2xl leading-relaxed">
              Our suite of services is designed to cover every angle of your financial landscape, ensuring compliance while seizing opportunities for growth.
            </p>
            <a href="/services" class="group inline-flex items-center gap-3 transition-all hover:gap-5 text-base font-medium text-[#3305d8] border-[#3305d8] border-b mt-12 pb-2">
              View All Services
            </a>
          </div>
        </div>

        <div class="lg:col-span-2 space-y-8">
          <div class="group relative overflow-hidden rounded-3xl bg-white p-12 border border-[#676769]/20 shadow-sm transition-all duration-500 hover:shadow-2xl hover:shadow-[#3305d8]/10 hover:border-[#3305d8]/20">
            <div class="absolute right-0 top-0 -mt-8 -mr-8 h-56 w-56 rounded-full bg-[#676769]/5 opacity-50 transition-transform duration-700 group-hover:scale-150 group-hover:bg-[#3305d8]/10"></div>
            <div class="relative z-10 flex flex-col md:flex-row gap-10 items-start">
              <div class="flex-shrink-0">
                <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-slate-50 text-[#676769] ring-1 ring-slate-100 transition-all duration-500 group-hover:bg-[#3305d8] group-hover:text-white group-hover:scale-105">
                  <i data-lucide="file-check-2" class="h-10 w-10"></i>
                </div>
              </div>
              <div>
                <h3 class="font-serif text-3xl text-slate-900 mb-4 group-hover:text-[#3305d8]">Compliance</h3>
                <p class="text-[#676769] font-light text-xl leading-relaxed mb-8">
                  Navigating the complex regulatory environment with absolute precision.
                </p>
                <ul class="flex flex-col gap-4">
                  <li class="flex items-start gap-3 text-lg font-light text-[#676769] group-hover:text-slate-700">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#3305d8]/60"></span>
                    <span>Taxes: Personal, Business, and Corporate</span>
                  </li>
                  <li class="flex items-start gap-3 text-lg font-light text-[#676769] group-hover:text-slate-700">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#3305d8]/60"></span>
                    <span>Knowledgeable Local Sales Tax, GST</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="group relative overflow-hidden rounded-3xl bg-white p-12 border border-[#676769]/20 shadow-sm transition-all duration-500 hover:shadow-2xl hover:shadow-[#3305d8]/10 hover:border-[#3305d8]/20">
            <div class="absolute right-0 top-0 -mt-8 -mr-8 h-56 w-56 rounded-full bg-[#676769]/5 opacity-50 transition-transform duration-700 group-hover:scale-150 group-hover:bg-[#3305d8]/10"></div>
            <div class="relative z-10 flex flex-col md:flex-row gap-10 items-start">
              <div class="flex-shrink-0">
                <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-slate-50 text-[#676769] ring-1 ring-slate-100 transition-all duration-500 group-hover:bg-[#3305d8] group-hover:text-white group-hover:scale-105">
                  <i data-lucide="bar-chart-3" class="h-10 w-10"></i>
                </div>
              </div>
              <div>
                <h3 class="font-serif text-3xl text-slate-900 mb-4 group-hover:text-[#3305d8]">Management</h3>
                <p class="text-[#676769] font-light text-xl leading-relaxed mb-8">
                  Daily operational stewardship to keep your business running efficiently.
                </p>
                <ul class="flex flex-col gap-4">
                  <li class="flex items-start gap-3 text-lg font-light text-[#676769] group-hover:text-slate-700">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#3305d8]/60"></span>
                    <span>Bookkeeping: manage daily transactions</span>
                  </li>
                  <li class="flex items-start gap-3 text-lg font-light text-[#676769] group-hover:text-slate-700">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#3305d8]/60"></span>
                    <span>Payroll: Management of payroll and taxes</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="group relative overflow-hidden rounded-3xl bg-white p-12 border border-[#676769]/20 shadow-sm transition-all duration-500 hover:shadow-2xl hover:shadow-[#3305d8]/10 hover:border-[#3305d8]/20">
            <div class="absolute right-0 top-0 -mt-8 -mr-8 h-56 w-56 rounded-full bg-[#676769]/5 opacity-50 transition-transform duration-700 group-hover:scale-150 group-hover:bg-[#3305d8]/10"></div>
            <div class="relative z-10 flex flex-col md:flex-row gap-10 items-start">
              <div class="flex-shrink-0">
                <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-slate-50 text-[#676769] ring-1 ring-slate-100 transition-all duration-500 group-hover:bg-[#3305d8] group-hover:text-white group-hover:scale-105">
                  <i data-lucide="message-square-text" class="h-10 w-10"></i>
                </div>
              </div>
              <div>
                <h3 class="font-serif text-3xl text-slate-900 mb-4 group-hover:text-[#3305d8]">Advisory</h3>
                <p class="text-[#676769] font-light text-xl leading-relaxed mb-8">
                  Forward-looking guidance to help you make informed decisions.
                </p>
                <ul class="flex flex-col gap-4">
                  <li class="flex items-start gap-3 text-lg font-light text-[#676769] group-hover:text-slate-700">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#3305d8]/60"></span>
                    <span>Reporting: Help directors make informed decisions</span>
                  </li>
                  <li class="flex items-start gap-3 text-lg font-light text-[#676769] group-hover:text-slate-700">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#3305d8]/60"></span>
                    <span>Capital Fundraising: Advice on seeking equity</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Financial Thread (Process Section) -->
  <section id="process" class="py-40 bg-white relative overflow-hidden">
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-10 pointer-events-none w-[1200px] h-full z-0">
      <svg viewBox="0 0 1440 600" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
        <path d="M-200 100 C 400 600 800 -100 1640 400" stroke="url(#sw-gradient)" stroke-width="4" fill="none"></path>
      </svg>
    </div>

    <div class="mx-auto max-w-7xl px-8 relative">
      <div class="mb-32 text-center">
        <span class="uppercase text-sm font-semibold tracking-widest text-[#3305d8]">Methodology</span>
        <h2 class="text-5xl text-slate-900 tracking-tight font-serif mt-6">Our Process</h2>
      </div>

      <div class="absolute left-8 md:left-1/2 top-48 bottom-0 w-px bg-[#676769]/20 hidden md:block">
        <div class="absolute inset-0 w-full h-full process-line"></div>
      </div>

      <div class="z-10 relative space-y-32">
        <div class="group relative flex flex-col md:flex-row md:items-center gap-12">
          <div class="md:w-1/2 md:text-right md:pr-16 order-2 md:order-1">
            <h3 class="group-hover:text-[#3305d8] transition-colors text-4xl text-slate-900 font-serif mb-6">Connect</h3>
            <p class="text-xl font-light leading-relaxed text-[#676769]">Reach out via phone, email, or website.</p>
          </div>
          <div class="absolute left-0 md:left-1/2 top-0 md:top-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-4 border-[#3305d8]/20 z-20 group-hover:border-[#3305d8] group-hover:scale-150 transition-all duration-500 hidden md:block"></div>
          <div class="md:w-1/2 md:pl-16 order-1 md:order-2 flex items-center">
            <span class="font-serif text-[12rem] leading-none text-[#676769]/5 group-hover:text-[#3305d8]/10 transition-colors duration-500 select-none">1</span>
          </div>
        </div>

        <div class="group relative flex flex-col md:flex-row md:items-center gap-12">
          <div class="md:w-1/2 md:text-right md:pr-16 order-1 md:order-1 flex justify-end items-center">
            <span class="text-[12rem] leading-none group-hover:text-[#3305d8]/10 transition-colors duration-500 select-none text-[#676769]/5 font-serif">2</span>
          </div>
          <div class="absolute left-0 md:left-1/2 top-0 md:top-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-4 border-[#3305d8]/20 z-20 group-hover:border-[#3305d8] group-hover:scale-150 transition-all duration-500 hidden md:block"></div>
          <div class="md:w-1/2 md:pl-16 order-2 md:order-2">
            <h3 class="text-4xl font-serif text-slate-900 mb-6 group-hover:text-[#3305d8] transition-colors">Analyse</h3>
            <p class="text-xl font-light leading-relaxed text-[#676769]">
              Meet the client personnel to analyse and understand requirements, challenges faced, expectations etc.
            </p>
          </div>
        </div>

        <div class="group relative flex flex-col md:flex-row md:items-center gap-12">
          <div class="md:w-1/2 md:text-right md:pr-16 order-2 md:order-1">
            <h3 class="group-hover:text-[#3305d8] transition-colors text-4xl text-slate-900 font-serif mb-6">Engage</h3>
            <p class="text-xl font-light leading-relaxed text-[#676769]">
              Discuss scope of work, periodicity, fees, and other aspects and sign engagement letter.
            </p>
          </div>
          <div class="absolute left-0 md:left-1/2 top-0 md:top-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-4 border-[#3305d8]/20 z-20 group-hover:border-[#3305d8] group-hover:scale-150 transition-all duration-500 hidden md:block"></div>
          <div class="md:w-1/2 md:pl-16 order-1 md:order-2 flex items-center">
            <span class="font-serif text-[12rem] leading-none text-[#676769]/5 group-hover:text-[#3305d8]/10 transition-colors duration-500 select-none">3</span>
          </div>
        </div>

        <div class="group relative flex flex-col md:flex-row md:items-center gap-12">
          <div class="md:w-1/2 md:text-right md:pr-16 order-1 md:order-1 flex justify-end items-center">
            <span class="text-[12rem] leading-none group-hover:text-[#3305d8]/10 transition-colors duration-500 select-none text-[#676769]/5 font-serif">4</span>
          </div>
          <div class="absolute left-0 md:left-1/2 top-0 md:top-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-4 border-[#3305d8]/20 z-20 group-hover:border-[#3305d8] group-hover:scale-150 transition-all duration-500 hidden md:block"></div>
          <div class="md:w-1/2 md:pl-16 order-2 md:order-2">
            <h3 class="text-4xl font-serif text-slate-900 mb-6 group-hover:text-[#3305d8] transition-colors">Onboarding</h3>
            <p class="text-xl font-light leading-relaxed text-[#676769]">
              Gather onboarding information and set up communication channels for future communication and information sharing.
            </p>
          </div>
        </div>

        <div class="group relative flex flex-col md:flex-row md:items-center gap-12">
